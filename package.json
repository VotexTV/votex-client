{
  "name": "votex-client",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/launcher/vite.config.ts",
    "build": "tsc -p apps/launcher/tsconfig.json && vite build --config apps/launcher/vite.config.ts",
    "test": "vitest run",
    "desktop": "cd apps/launcher && tauri dev",
    "desktop:build": "cd apps/launcher && tauri build",
    "check:rust": "cargo check --manifest-path apps/launcher/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "three": "0.156.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.156.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
